
<div class="text-center py-5 mb-4">
  <h1 class="display-4 fw-bold"><%= t("home.title") %></h1>

  <p class="lead text-secondary mt-3">
    <%= t("home.subtitle") %>
  </p>
</div>

<div class="row g-4 mt-3">
  <div class="col-md-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body text-center p-4">
        <h5 class="card-title fw-bold"><%= t("home.inventories.title") %></h5>
        <p class="card-text text-secondary">
          <%= t("home.inventories.description") %>
        </p>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body text-center p-4">
        <h5 class="card-title fw-bold"><%= t("home.items.title") %></h5>
        <p class="card-text text-secondary">
          <%= t("home.items.description") %>
        </p>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body text-center p-4">
        <h5 class="card-title fw-bold"><%= t("home.collaborate.title") %></h5>
        <p class="card-text text-secondary">
          <%= t("home.collaborate.description") %>
        </p>
      </div>
    </div>
  </div>
</div>
