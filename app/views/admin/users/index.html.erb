
<div class="container mt-4">
  <div class="mb-4">
    <h2><%= t("admin.users.title") %></h2>
    <p class="text-muted"><%= t("admin.users.subtitle") %></p>
  </div>

  <%= form_with url: manage_admin_users_path,
                method: :post,
                local: true do %>

    <div class="card mb-3">
      <div class="card-body">
        <div class="d-flex flex-wrap align-items-center gap-3">

          <strong><%= t("admin.users.selected_actions") %></strong>

          <%= select_tag :bulk_action,
              options_for_select([
                [t("admin.users.choose_action"), ""],
                [t("admin.users.actions.block"), "block"],
                [t("admin.users.actions.unblock"), "unblock"],
                [t("admin.users.actions.promote"), "promote"],
                [t("admin.users.actions.demote"), "demote"],
                [t("admin.users.actions.delete"), "delete"]
              ]),
              class: "form-select",
              style: "width: 190px;",
              required: true %>

          <%= submit_tag t("admin.users.apply"),
              class: "btn btn-primary",
              data: {
                turbo_confirm: t("admin.users.confirm")
              } %>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <strong>
          <%= t("admin.users.users_count", count: @users.count) %>
        </strong>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>
                <input type="checkbox"
                       id="selectAllUsers"
                       class="form-check-input">
              </th>
              <th><%= t("admin.users.username") %></th>
              <th><%= t("admin.users.email") %></th>
              <th><%= t("admin.users.role") %></th>
              <th><%= t("admin.users.status") %></th>
            </tr>
          </thead>

          <tbody>
            <% @users.each do |user| %>
              <tr>
                <td>
                  <%= check_box_tag "user_ids[]",
                      user.id,
                      false,
                      class: "form-check-input user-checkbox" %>
                </td>

                <td><%= user.username %></td>
                <td><%= user.email %></td>

                <td>
                  <% if user.admin? %>
                    <span class="badge bg-primary">
                      <%= t("admin.users.admin_role") %>
                    </span>
                  <% else %>
                    <span class="badge bg-secondary">
                      <%= t("admin.users.user_role") %>
                    </span>
                  <% end %>
                </td>

                <td>
                  <% if user.blocked? %>
                    <span class="badge bg-danger">
                      <%= t("admin.users.blocked") %>
                    </span>
                  <% else %>
                    <span class="badge bg-success">
                      <%= t("admin.users.active") %>
                    </span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

  <% end %>
</div>

<script>
  document.addEventListener("turbo:load", setupUserSelection);
  document.addEventListener("DOMContentLoaded", setupUserSelection);

  function setupUserSelection() {
    const selectAll = document.getElementById("selectAllUsers");
    const checkboxes = document.querySelectorAll(".user-checkbox");

    if (!selectAll) return;

    selectAll.onchange = function () {
      checkboxes.forEach(function (checkbox) {
        checkbox.checked = selectAll.checked;
      });
    };

    checkboxes.forEach(function (checkbox) {
      checkbox.onchange = function () {
        selectAll.checked =
          Array.from(checkboxes).every(function (item) {
            return item.checked;
          });
      };
    });
  }
</script>
