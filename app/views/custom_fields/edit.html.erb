<div class="container mt-4">
  <div class="card shadow-sm">
    <div class="card-body p-4">
      <h4>Edit Custom Field</h4>

      <%= form_with model: [@inventory, @custom_field] do |form| %>
        <div class="mb-3">
          <%= form.label :title, "Field Title" %>
          <%= form.text_field :title, class: "form-control", required: true %>
        </div>

        <div class="mb-3">
          <%= form.label :field_type, "Field Type" %>
          <%= form.select :field_type,
              CustomField::FIELD_TYPES.map { |type| [type.titleize, type] },
              {}, class: "form-select" %>
        </div>

        <div class="mb-3">
          <%= form.label :description %>
          <%= form.text_area :description, class: "form-control", rows: 2 %>
        </div>

        <div class="form-check mb-3">
          <%= form.check_box :show_in_table, class: "form-check-input" %>
          <%= form.label :show_in_table,
              "Show in items table", class: "form-check-label" %>
        </div>

        <%= form.submit "Save Changes", class: "btn btn-success" %>

        <%= link_to "Cancel", @inventory,
            class: "btn btn-outline-secondary" %>
      <% end %>
    </div>
  </div>
</div>