
<div class="container mt-4">
  <div class="mb-4">
    <h2><%= t("dashboard.title") %></h2>
    <p class="text-muted"><%= t("dashboard.subtitle") %></p>
  </div>

  <%# OWNED INVENTORIES %>
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><%= t("dashboard.owned_inventories") %></h4>

        <%= link_to t("dashboard.create_inventory"), new_inventory_path,
            class: "btn btn-primary btn-sm" %>
      </div>

      <%= form_with url: dashboard_path, method: :get, local: true do |form| %>
        <div class="row g-3 mb-3">
          <div class="col-md-4">
            <%= form.label :owned_category, t("dashboard.filter_category"), class: "form-label" %>
            <%= form.select :owned_category,
                options_for_select(
                  [[t("dashboard.all_categories"), ""]] +
                  @owned_categories.map { |category| [category, category] },
                  params[:owned_category]
                ),
                {},
                class: "form-select" %>
          </div>

          <div class="col-md-3">
            <%= form.label :owned_sort, t("dashboard.sort_by"), class: "form-label" %>
            <%= form.select :owned_sort,
                options_for_select(
                  [
                    [t("dashboard.newest_first"), "created_at"],
                    [t("dashboard.title_column"), "title"]
                  ],
                  params[:owned_sort] || "created_at"
                ),
                {},
                class: "form-select" %>
          </div>

          <div class="col-md-3">
            <%= form.label :owned_direction, t("dashboard.direction"), class: "form-label" %>
            <%= form.select :owned_direction,
                options_for_select(
                  [
                    [t("dashboard.ascending"), "asc"],
                    [t("dashboard.descending"), "desc"]
                  ],
                  params[:owned_direction] || "desc"
                ),
                {},
                class: "form-select" %>
          </div>

          <div class="col-md-2 d-flex align-items-end gap-2">
            <%= form.submit t("dashboard.apply"), class: "btn btn-primary" %>
            <%= link_to t("dashboard.clear"),
                dashboard_path(
                  writable_category: params[:writable_category],
                  writable_sort: params[:writable_sort],
                  writable_direction: params[:writable_direction]
                ),
                class: "btn btn-outline-secondary" %>
          </div>
        </div>
      <% end %>

      <% if @my_inventories.any? %>
        <div class="table-responsive">
          <table class="table table-hover table-bordered align-middle">
            <thead class="table-light">
              <tr>
                <th><%= t("dashboard.title_column") %></th>
                <th><%= t("dashboard.category") %></th>
                <th><%= t("dashboard.description") %></th>
                <th><%= t("dashboard.created_at") %></th>
              </tr>
            </thead>
            <tbody>
              <% @my_inventories.each do |inventory| %>
                <tr>
                  <td>
                    <%= link_to inventory.title, inventory_path(inventory),
                        class: "text-decoration-none fw-semibold" %>
                  </td>
                  <td><%= inventory.category %></td>
                  <td><%= truncate(inventory.description, length: 60) %></td>
                  <td><%= l(inventory.created_at, format: :long) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="alert alert-info mb-0">
          <%= t("dashboard.owned_empty_message") %>
        </div>
      <% end %>
    </div>
  </div>

  <%# WRITABLE INVENTORIES %>
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h4 class="mb-3"><%= t("dashboard.writable_inventories") %></h4>

      <%= form_with url: dashboard_path, method: :get, local: true do |form| %>
        <div class="row g-3 mb-3">
          <div class="col-md-4">
            <%= form.label :writable_category, t("dashboard.filter_category"), class: "form-label" %>
            <%= form.select :writable_category,
                options_for_select(
                  [[t("dashboard.all_categories"), ""]] +
                  @writable_categories.map { |category| [category, category] },
                  params[:writable_category]
                ),
                {},
                class: "form-select" %>
          </div>

          <div class="col-md-3">
            <%= form.label :writable_sort, t("dashboard.sort_by"), class: "form-label" %>
            <%= form.select :writable_sort,
                options_for_select(
                  [
                    [t("dashboard.newest_first"), "created_at"],
                    [t("dashboard.title_column"), "title"]
                  ],
                  params[:writable_sort] || "created_at"
                ),
                {},
                class: "form-select" %>
          </div>

          <div class="col-md-3">
            <%= form.label :writable_direction, t("dashboard.direction"), class: "form-label" %>
            <%= form.select :writable_direction,
                options_for_select(
                  [
                    [t("dashboard.ascending"), "asc"],
                    [t("dashboard.descending"), "desc"]
                  ],
                  params[:writable_direction] || "desc"
                ),
                {},
                class: "form-select" %>
          </div>

          <div class="col-md-2 d-flex align-items-end gap-2">
            <%= form.submit t("dashboard.apply"), class: "btn btn-primary" %>
            <%= link_to t("dashboard.clear"),
                dashboard_path(
                  owned_category: params[:owned_category],
                  owned_sort: params[:owned_sort],
                  owned_direction: params[:owned_direction]
                ),
                class: "btn btn-outline-secondary" %>
          </div>
        </div>
      <% end %>

      <% if @writable_inventories.any? %>
        <div class="table-responsive">
          <table class="table table-hover table-bordered align-middle">
            <thead class="table-light">
              <tr>
                <th><%= t("dashboard.title_column") %></th>
                <th><%= t("dashboard.owner") %></th>
                <th><%= t("dashboard.category") %></th>
                <th><%= t("dashboard.description") %></th>
                <th><%= t("dashboard.created_at") %></th>
              </tr>
            </thead>
            <tbody>
              <% @writable_inventories.each do |inventory| %>
                <tr>
                  <td>
                    <%= link_to inventory.title, inventory_path(inventory),
                        class: "text-decoration-none fw-semibold" %>
                  </td>
                  <td><%= inventory.user.username %></td>
                  <td><%= inventory.category %></td>
                  <td><%= truncate(inventory.description, length: 60) %></td>
                  <td><%= l(inventory.created_at, format: :long) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="alert alert-info mb-0">
          <%= t("dashboard.writable_empty_message") %>
        </div>
      <% end %>
    </div>
  </div>
</div>
