
<div class="container mt-4">
  <div class="mb-4">
    <h2><%= t("dashboard.title") %></h2>
    <p class="text-muted"><%= t("dashboard.subtitle") %></p>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><%= t("dashboard.my_inventories") %></h4>

        <%= link_to t("dashboard.create_inventory"), new_inventory_path,
            class: "btn btn-primary btn-sm" %>
      </div>

      <%= form_with url: dashboard_path, method: :get, local: true do |form| %>
        <div class="row g-3 mb-3">
          <div class="col-md-4">
            <%= form.label :category, t("dashboard.filter_category"), class: "form-label" %>
            <%= form.select :category,
                options_for_select(
                  [[t("dashboard.all_categories"), ""]] + @categories.map { |c| [c, c] },
                  params[:category]
                ),
                {},
                class: "form-select" %>
          </div>

          <div class="col-md-4">
            <%= form.label :sort, t("dashboard.sort_by"), class: "form-label" %>
            <%= form.select :sort,
                options_for_select(
                  [[t("dashboard.newest_first"), "created_at"], [t("dashboard.title_column"), "title"]],
                  params[:sort] || "created_at"
                ),
                {},
                class: "form-select" %>
          </div>

          <div class="col-md-2">
            <%= form.label :direction, t("dashboard.direction"), class: "form-label" %>
            <%= form.select :direction,
                options_for_select(
                  [[t("dashboard.ascending"), "asc"], [t("dashboard.descending"), "desc"]],
                  params[:direction] || "desc"
                ),
                {},
                class: "form-select" %>
          </div>

          <div class="col-md-2 d-flex align-items-end gap-2">
            <%= form.submit t("dashboard.apply"), class: "btn btn-primary" %>
            <%= link_to t("dashboard.clear"), dashboard_path,
                class: "btn btn-outline-secondary" %>
          </div>
        </div>
      <% end %>

      <% if @my_inventories.any? %>
        <div class="table-responsive">
          <table class="table table-hover table-bordered align-middle">
            <thead class="table-light">
              <tr>
                <th><%= t("dashboard.title_column") %></th>
                <th><%= t("dashboard.category") %></th>
                <th><%= t("dashboard.description") %></th>
                <th><%= t("dashboard.created_at") %></th>
              </tr>
            </thead>

            <tbody>
              <% @my_inventories.each do |inventory| %>
                <tr>
                  <td>
                    <%= link_to inventory.title, inventory_path(inventory),
                        class: "text-decoration-none fw-semibold" %>
                  </td>
                  <td><%= inventory.category %></td>
                  <td><%= truncate(inventory.description, length: 60) %></td>
                  <td><%= l(inventory.created_at, format: :long) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="alert alert-info mb-0">
          <%= t("dashboard.empty_message") %>
        </div>
      <% end %>
    </div>
  </div>
</div>
