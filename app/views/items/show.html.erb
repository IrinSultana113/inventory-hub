<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Item Details</h2>

    <%= link_to "Back to Items",
        inventory_items_path(@inventory),
        class: "btn btn-outline-secondary" %>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <h4 class="card-title mb-3">Custom ID: <%= @item.custom_id %></h4>

      <p>
        <strong>Created By:</strong>
        <%= @item.user&.username || "Unknown" %>
      </p>

      <p>
        <strong>Created At:</strong>
        <%= l(@item.created_at, format: :long) %>
      </p>

      <hr>

      <h5 class="mb-3">Custom Field Values</h5>

      <% if @custom_field_values.any? %>
        <% @custom_field_values.each do |field_value| %>
          <% field = field_value.custom_field %>
          <% next unless field %>

          <p>
            <strong><%= field.title %>:</strong>
            <%= field_value.value.presence || "—" %>
          </p>
        <% end %>
      <% else %>
        <p class="text-muted">No custom field values available.</p>
      <% end %>
    </div>
  </div>
</div>