
<div class="container mt-4">
  <div class="card shadow-sm">
    <div class="card-body p-4">
      <h3 class="mb-3"><%= t("items.show.title") %></h3>

      <p>
        <strong><%= t("items.show.custom_id") %>:</strong>
        <%= @item.custom_id.presence || t("items.show.not_generated") %>
      </p>

      <p>
        <strong><%= t("items.show.created_by") %>:</strong>
        <%= @item.user.username %>
      </p>

      <p>
        <strong><%= t("items.show.created_at") %>:</strong>
        <%= l(@item.created_at, format: :long) %>
      </p>

      <hr>

      <h5><%= t("items.show.custom_fields") %></h5>

      <% @custom_field_values.each do |field_value| %>
        <div class="mb-3">
          <strong><%= field_value.custom_field.title %>:</strong>

          <% if field_value.custom_field.field_type == "boolean" %>
            <%= field_value.value == "true" ?
                t("items.show.yes") : t("items.show.no") %>
          <% elsif field_value.custom_field.field_type == "link" && field_value.value.present? %>
            <%= link_to field_value.value, field_value.value,
                target: "_blank", rel: "noopener" %>
          <% else %>
            <%= field_value.value.presence || "—" %>
          <% end %>
        </div>
      <% end %>

      <%= link_to t("items.show.back_to_items"),
          inventory_items_path(@inventory),
          class: "btn btn-outline-secondary" %>
    </div>
  </div>
</div>
