
<div class="container mt-4">
  <div class="card shadow-sm">
    <div class="card-body p-4">
      <h3 class="mb-3"><%= t("items.new.title") %></h3>

      <p class="text-muted">
        <%= t("items.new.inventory") %>: <%= @inventory.title %>
      </p>

      <%= render "form" %>

      <%= link_to t("items.new.back_to_items"),
          inventory_items_path(@inventory),
          class: "btn btn-outline-secondary mt-3" %>
    </div>
  </div>
</div>
