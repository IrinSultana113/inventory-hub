
<%= form_with model: [@inventory, @item] do |form| %>
  <% if @item.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :custom_id, t("items.form.custom_id"),
        class: "form-label" %>

    <%= form.text_field :custom_id,
        class: "form-control",
        placeholder: t("items.form.custom_id_placeholder") %>

    <div class="form-text">
      <%= t("items.form.custom_id_help") %>
    </div>
  </div>

  <div class="row mb-3">
    <div class="col-md-6">
      <label class="form-label">
        <%= t("items.form.created_by") %>
      </label>

      <input type="text"
             class="form-control"
             value="<%= @item.persisted? ? @item.user.username : current_user.username %>"
             readonly>
    </div>

    <div class="col-md-6">
      <label class="form-label">
        <%= t("items.form.created_at") %>
      </label>

      <input type="text"
             class="form-control"
             value="<%= @item.persisted? ? l(@item.created_at, format: :long) : t('items.form.automatically_set') %>"
             readonly>
    </div>
  </div>

  <% @item.custom_field_values.each do |field_value| %>
    <% field = field_value.custom_field %>
    <% next unless field %>

    <%= form.fields_for :custom_field_values, field_value do |value_form| %>
      <div class="mb-3">
        <%= value_form.label :value, field.title, class: "form-label" %>

        <% if field.description.present? %>
          <span
            class="d-inline-flex align-items-center ms-1 text-secondary"
            data-bs-toggle="tooltip"
            data-bs-placement="top"
            title="<%= field.description %>"
            role="img"
            aria-label="<%= field.description %>"
            tabindex="0">
            &#9432;
          </span>
        <% end %>

        <% case field.field_type %>
        <% when "string" %>
          <%= value_form.text_field :value, class: "form-control" %>

        <% when "text" %>
          <%= value_form.text_area :value, class: "form-control", rows: 3 %>

        <% when "number" %>
          <%= value_form.number_field :value, class: "form-control", step: :any %>

        <% when "link" %>
          <%= value_form.url_field :value,
              class: "form-control",
              placeholder: t("items.form.url_placeholder") %>

        <% when "boolean" %>
          <div class="form-check">
            <%= value_form.check_box :value,
                {
                  class: "form-check-input",
                  checked: field_value.value == "true"
                },
                "true",
                "false" %>

            <%= value_form.label :value,
                t("items.form.yes"),
                class: "form-check-label" %>
          </div>
        <% end %>

        <%= value_form.hidden_field :custom_field_id %>
      </div>
    <% end %>
  <% end %>

  <%= form.submit t("items.form.save"), class: "btn btn-primary" %>
<% end %>
