
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h4><%= t("inventories.items.title") %></h4>
    <p class="text-muted mb-0"><%= t("inventories.items.subtitle") %></p>
  </div>

  <% if @inventory.can_write_items?(current_user) %>
    <%= link_to t("inventories.items.add_new"),
        new_inventory_item_path(@inventory),
        class: "btn btn-primary" %>
  <% end %>
</div>

<% if @inventory.can_write_items?(current_user) %>
  <%= form_with url: bulk_destroy_inventory_items_path(@inventory),
      method: :delete do %>

    <div class="mb-3">
      <%= button_tag t("inventories.items.edit_selected"),
          type: "submit",
          name: "action_type",
          value: "edit",
          formaction: manage_inventory_items_path(@inventory),
          formmethod: "post",
          class: "btn btn-warning me-2" %>

      <%= submit_tag t("inventories.items.delete_selected"),
          class: "btn btn-danger",
          data: { turbo_confirm: t("inventories.items.confirm_delete") } %>
    </div>

    <%= render "items_table", selectable: true %>
  <% end %>
<% else %>
  <%= render "items_table", selectable: false %>
<% end %>

<% if @items.empty? %>
  <p class="text-muted text-center mt-4"><%= t("inventories.items.empty_message") %></p>
<% end %>
