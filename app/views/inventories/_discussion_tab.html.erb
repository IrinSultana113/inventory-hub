
<h4 class="mb-3">
  <%= t("inventories.show.discussion") %>
</h4>

<!-- Discussion posts -->
<div id="discussion-posts"
     data-controller="discussion"
     data-discussion-url-value="<%= inventory_discussion_posts_path(@inventory, format: :json) %>"
     data-discussion-last-id-value="<%= @discussion_posts.last&.id || 0 %>"
     data-discussion-target="posts">

  <% if @discussion_posts.any? %>
    <% @discussion_posts.each do |post| %>
      <%= render "discussion_posts/post", post: post %>
    <% end %>
  <% else %>
    <p class="text-muted" id="no-discussion-posts">
      <%= t("inventories.discussion.no_comments") %>
    </p>
  <% end %>

</div>

<hr class="my-4">

<!-- Comment form -->
<% if user_signed_in? %>

  <h5 class="mb-3">
    <%= t("inventories.discussion.write_comment") %>
  </h5>

  <%= form_with model: [@inventory, DiscussionPost.new],
                id: "discussion-post-form",
                data: { turbo: false } do |form| %>

    <div class="mb-3">
      <%= form.label :body,
                     t("inventories.discussion.comment"),
                     class: "form-label" %>

      <%= form.text_area :body,
                         rows: 4,
                         maxlength: 10_000,
                         required: true,
                         class: "form-control",
                         placeholder: t("inventories.discussion.comment_placeholder") %>
    </div>

    <%= render "inventories/markdown_guide" %>

    <%= form.submit t("inventories.discussion.post_comment"),
                    class: "btn btn-primary" %>

  <% end %>

<% else %>

  <div class="alert alert-info">
    <%= t("inventories.discussion.please") %>
    <%= link_to t("inventories.discussion.sign_in"),
                new_user_session_path %>
    <%= t("inventories.discussion.sign_in_to_write") %>
  </div>

<% end %>
