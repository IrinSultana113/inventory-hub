
<div class="mb-3">
  <h4><%= t("inventories.custom_id.title") %></h4>
  <p class="text-muted">
    <%= t("inventories.custom_id.subtitle") %>
  </p>
</div>

<% can_manage = user_signed_in? &&
    (current_user.admin? || @inventory.user_id == current_user.id) %>

<% if can_manage %>

  <%= form_with model: @inventory,
      url: update_custom_id_format_inventory_path(@inventory),
      method: :patch do |form| %>

    <%= render "custom_id_builder" %>

    <div class="mt-4">
      <%= form.submit t("inventories.custom_id.save"),
          class: "btn btn-primary" %>
    </div>
  <% end %>

<% else %>

  <p class="text-muted">
    <%= t("inventories.custom_id.permission_message") %>
  </p>

  <h5><%= t("inventories.custom_id.current_format") %></h5>

  <% @inventory.effective_custom_id_format.each do |element| %>
    <div class="border rounded p-2 mb-2">
      <strong>
        <%= t("inventories.custom_id.element_types.#{element['type']}",
            default: element["type"].to_s.titleize) %>
      </strong>

      <% if element["value"].present? %>
        — <%= element["value"] %>
      <% end %>

      <% if element["format"].present? %>
        — <%= element["format"] %>
      <% end %>
    </div>
  <% end %>

<% end %>
