<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>All Inventories</h2>

    <% if user_signed_in? %>
      <%= link_to "Create Inventory", new_inventory_path,
          class: "btn btn-primary" %>
    <% end %>
  </div>

  <% if @inventories.any? %>
    <%= form_with url: bulk_destroy_inventories_path,
                  method: :delete,
                  id: "bulk-delete-form" do %>

      <% if user_signed_in? %>
        <div class="d-flex align-items-center gap-3 mb-3">
          <div>
            <%= check_box_tag "select_all", "1", false,
                id: "select-all",
                class: "form-check-input" %>
            <%= label_tag "select-all", "Select all",
                class: "form-check-label" %>
          </div>
          <button type="button"
                id="edit-selected"
                class="btn btn-outline-primary btn-sm"
                disabled>Edit Selected
          </button>
          <%= submit_tag "Delete Selected",
              class: "btn btn-danger btn-sm",
              data: { turbo_confirm: "Delete selected inventories?" }
               %>
        </div>
      <% end %>

      <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle">
          <thead class="table-light">
            <tr>
              <% if user_signed_in? %>
                <th>Select</th>
              <% end %>
              <th>Title</th>
              <th>Category</th>
              <th>Owner</th>
              <th>Created At</th>
            </tr>
          </thead>

          <tbody>
            <% @inventories.each do |inventory| %>
              <tr>
                <% if user_signed_in? %>
                  <td>
                    <% if current_user.admin? || inventory.user_id == current_user.id %>
                      <%= check_box_tag "inventory_ids[]", inventory.id,
                          false, class: "inventory-checkbox form-check-input" %>
                    <% end %>
                  </td>
                <% end %>

                <td>
                  <%= link_to inventory.title, inventory_path(inventory),
                      class: "text-decoration-none fw-semibold" %>
                </td>
                <td><%= inventory.category %></td>
                <td><%= inventory.user.username %></td>
                <td><%= l(inventory.created_at, format: :long) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% else %>
    <div class="alert alert-info">
      No inventories found.
    </div>
  <% end %>
</div>

<script>
  document.addEventListener("turbo:load", () => {
  const selectAll = document.getElementById("select-all");
  const checkboxes = document.querySelectorAll(".inventory-checkbox");
  const editButton = document.getElementById("edit-selected");

  if (!selectAll) return;

  function updateSelection() {
    const selected = [...checkboxes].filter((checkbox) => checkbox.checked);

    selectAll.checked =
      checkboxes.length > 0 && selected.length === checkboxes.length;

    editButton.disabled = selected.length !== 1;
  }

  selectAll.addEventListener("change", () => {
    checkboxes.forEach((checkbox) => {
      checkbox.checked = selectAll.checked;
    });
    updateSelection();
  });

  checkboxes.forEach((checkbox) => {
    checkbox.addEventListener("change", updateSelection);
  });

  editButton.addEventListener("click", () => {
    const selected = [...checkboxes].filter((checkbox) => checkbox.checked);

    if (selected.length === 1) {
      window.location.href = `/inventories/${selected[0].value}/edit`;
    }
  });

  updateSelection();
});
</script>