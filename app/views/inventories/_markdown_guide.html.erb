
<details class="mb-3">
  <summary class="text-primary" style="cursor: pointer;">
    <%= t("inventories.discussion.markdown_guide") %>
  </summary>

  <div class="card card-body mt-2">
    <p><code># Heading</code> → <%= t("inventories.discussion.large_heading") %></p>
    <p><code>## Heading</code> → <%= t("inventories.discussion.smaller_heading") %></p>
    <p><code>**text**</code> → <strong><%= t("inventories.discussion.bold_text") %></strong></p>
    <p><code>*text*</code> → <em><%= t("inventories.discussion.italic_text") %></em></p>
    <p><code>- Item</code> → <%= t("inventories.discussion.bullet_list") %></p>
    <p><code>[Google](https://google.com)</code> → <%= t("inventories.discussion.link") %></p>
    <p class="mb-0"><code>`code`</code> → <code>code</code></p>
  </div>
</details>
