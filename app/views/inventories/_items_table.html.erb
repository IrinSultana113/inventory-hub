
<div class="table-responsive">
  <table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
      <tr>
        <% if selectable %>
          <th><%= t("inventories.items_table.select") %></th>
        <% end %>

        <th><%= t("inventories.items_table.custom_id") %></th>
        <th><%= t("inventories.items_table.created_by") %></th>
        <th><%= t("inventories.items_table.created_at") %></th>

        <% @custom_fields.each do |field| %>
          <th><%= field.title %></th>
        <% end %>
      </tr>
    </thead>

    <tbody>
      <% @items.each do |item| %>
        <tr>
          <% if selectable %>
            <td>
              <%= check_box_tag "item_ids[]", item.id, false %>
            </td>
          <% end %>

          <td>
            <%= link_to item.custom_id.presence || t("inventories.items_table.not_generated"),
                inventory_item_path(@inventory, item) %>
          </td>

          <td><%= item.user.username %></td>
          <td><%= l(item.created_at, format: :short) %></td>

          <% @custom_fields.each do |field| %>
            <% field_value = item.custom_field_values.find {
              |value| value.custom_field_id == field.id
            } %>

            <td>
              <% if field_value %>
                <% if field.field_type == "boolean" %>
                  <%= field_value.value == "true" ?
                      t("inventories.items_table.yes") :
                      t("inventories.items_table.no") %>
                <% else %>
                  <%= field_value.value.presence || "\u2014" %>
                <% end %>
              <% else %>
                <%= "\u2014" %>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
