
<div class="mb-3">
  <h4>General Settings</h4>
  <p class="text-muted">
    Manage your inventory title, description, category and visibility.
  </p>
</div>

<% if user_signed_in? &&
      (current_user.admin? || @inventory.user_id == current_user.id) %>

  <%= form_with model: @inventory,
    data: { turbo: false } do |form| %>

    <% if @inventory.errors.any? %>
      <div class="alert alert-danger">
        <% @inventory.errors.full_messages.each do |message| %>
          <p class="mb-1"><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div class="mb-3">
      <%= form.label :title, class: "form-label" %>
      <%= form.text_field :title, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= form.label :description, class: "form-label" %>
      <%= form.text_area :description,
          rows: 4, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :category, class: "form-label" %>
      <%= form.text_field :category,
          class: "form-control", required: true %>
    </div>

    <div class="form-check mb-3">
      <%= form.check_box :is_public, class: "form-check-input" %>

      <%= form.label :is_public,
          "Make this inventory public",
          class: "form-check-label" %>

      <div class="form-text">
        Public inventories allow all logged-in users to create,
        edit and delete items.
      </div>
    </div>

    <%= form.submit "Save Settings", class: "btn btn-primary" %>

  <% end %>

<% else %>

  <div class="card">
    <div class="card-body">
      <p><strong>Title:</strong> <%= @inventory.title %></p>

      <p>
        <strong>Description:</strong>
        <%= @inventory.description.presence || "No description provided." %>
      </p>

      <p><strong>Category:</strong> <%= @inventory.category %></p>

      <p>
        <strong>Visibility:</strong>
        <%= @inventory.is_public? ? "Public" : "Private" %>
      </p>

      <p class="text-muted mb-0">
        Only the inventory owner or an admin can change these settings.
      </p>
    </div>
  </div>

<% end %>
