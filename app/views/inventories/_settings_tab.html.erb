
<div class="mb-3">
  <h4><%= t("inventories.settings.title") %></h4>
  <p class="text-muted">
    <%= t("inventories.settings.subtitle") %>
  </p>
</div>

<% if user_signed_in? &&
      (current_user.admin? || @inventory.user_id == current_user.id) %>

  <%= form_with model: @inventory,
    data: { turbo: false } do |form| %>

    <% if @inventory.errors.any? %>
      <div class="alert alert-danger">
        <% @inventory.errors.full_messages.each do |message| %>
          <p class="mb-1"><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div class="mb-3">
      <%= form.label :title, t("inventories.settings.title_label"),
          class: "form-label" %>
      <%= form.text_field :title, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= form.label :description, t("inventories.settings.description"),
          class: "form-label" %>
      <%= form.text_area :description,
          rows: 4, class: "form-control" %>
      <%= render "inventories/markdown_guide" %>
    </div>

    <div class="mb-3">
      <%= form.label :category, t("inventories.settings.category"),
          class: "form-label" %>
      <%= form.text_field :category,
          class: "form-control", required: true %>
    </div>

    <div class="form-check mb-3">
      <%= form.check_box :is_public, class: "form-check-input" %>

      <%= form.label :is_public,
          t("inventories.settings.make_public"),
          class: "form-check-label" %>

      <div class="form-text">
        <%= t("inventories.settings.public_help") %>
      </div>
    </div>

    <%= form.submit t("inventories.settings.save"),
        class: "btn btn-primary" %>

  <% end %>

<% else %>

  <div class="card">
    <div class="card-body">
      <p>
        <strong><%= t("inventories.settings.title_label") %>:</strong>
        <%= @inventory.title %>
      </p>

      <div class="mb-3">
        <strong><%= t("inventories.settings.description") %>:</strong>

        <% if @inventory.description.present? %>
          <div class="mt-2">
            <%= markdown_to_html(@inventory.description) %>
          </div>
        <% else %>
          <p class="text-muted">
            <%= t("inventories.settings.no_description") %>
          </p>
        <% end %>
      </div>

      <p>
        <strong><%= t("inventories.settings.category") %>:</strong>
        <%= @inventory.category %>
      </p>

      <p>
        <strong><%= t("inventories.settings.visibility") %>:</strong>
        <%= @inventory.is_public? ?
            t("inventories.settings.public") :
            t("inventories.settings.private") %>
      </p>

      <p class="text-muted mb-0">
        <%= t("inventories.settings.permission_help") %>
      </p>
    </div>
  </div>

<% end %>
