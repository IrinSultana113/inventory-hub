
<div class="mb-3">
  <h4><%= t("inventories.custom_fields.title") %></h4>
  <p class="text-muted">
    <%= t("inventories.custom_fields.subtitle") %>
  </p>
</div>

<% can_manage = user_signed_in? &&
    (current_user.admin? || @inventory.user_id == current_user.id) %>

<% if can_manage %>
  <div class="card mb-4">
    <div class="card-body">
      <h5 class="mb-3"><%= t("inventories.custom_fields.add_title") %></h5>

      <%= form_with model: [@inventory, @custom_field],
          data: { turbo: false } do |form| %>
        <div class="mb-3">
          <%= form.label :title,
              t("inventories.custom_fields.field_title"),
              class: "form-label" %>
          <%= form.text_field :title,
              class: "form-control",
              placeholder: t("inventories.custom_fields.title_placeholder"),
              required: true %>
        </div>

        <div class="mb-3">
          <%= form.label :field_type,
              t("inventories.custom_fields.field_type"),
              class: "form-label" %>

          <%= form.select :field_type,
              CustomField::FIELD_TYPES.map { |type|
                [t("inventories.custom_fields.field_types.#{type}"), type]
              },
              { prompt: t("inventories.custom_fields.select_type") },
              class: "form-select",
              required: true %>
        </div>

        <div class="mb-3">
          <%= form.label :description,
              t("inventories.custom_fields.description"),
              class: "form-label" %>
          <%= form.text_area :description,
              class: "form-control",
              rows: 2,
              placeholder: t("inventories.custom_fields.description_placeholder") %>
        </div>

        <div class="form-check mb-3">
          <%= form.check_box :show_in_table,
              class: "form-check-input" %>

          <%= form.label :show_in_table,
              t("inventories.custom_fields.show_in_table"),
              class: "form-check-label" %>
        </div>

        <%= form.submit t("inventories.custom_fields.add_button"),
            class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
<% end %>

<% if @inventory.custom_fields.any? %>

  <% if can_manage %>
    <%= form_with url: manage_inventory_custom_fields_path(@inventory),
      method: :post,
      data: { turbo: false } do |form| %>

      <div class="mb-3">
        <%= button_tag t("inventories.custom_fields.edit_selected"),
          type: "submit",
          name: "action_type",
          value: "edit",
          class: "btn btn-warning me-2" %>

        <%= button_tag t("inventories.custom_fields.delete_selected"),
          type: "submit",
          name: "action_type",
          value: "delete",
          class: "btn btn-danger",
          data: {
            turbo_confirm: t("inventories.custom_fields.confirm_delete")
          } %>
      </div>

      <%= render "custom_fields_table", selectable: true %>
    <% end %>
  <% else %>
    <%= render "custom_fields_table", selectable: false %>
  <% end %>

<% else %>
  <p class="text-muted">
    <%= t("inventories.custom_fields.empty_message") %>
  </p>
<% end %>
