
<% element_types = %w[
  fixed_text sequence random_20bit random_32bit
  random_6_digit random_9_digit guid date time
] %>

<% element_names = element_types.index_with do |type|
     t("inventories.custom_id_builder.elements.#{type}.name")
   end %>

<div data-controller="custom-id-builder"
     data-element-names="<%= element_names.to_json %>"
     data-max-elements-message="<%= t('inventories.custom_id_builder.max_elements_message') %>"
     data-invalid-format-message="<%= t('inventories.custom_id_builder.invalid_format_message') %>"
     data-empty-preview-message="<%= t('inventories.custom_id_builder.empty_preview') %>"
     data-fixed-text-default="<%= t('inventories.custom_id_builder.fixed_text_default') %>">

  <h5 class="mb-3">
    <%= t("inventories.custom_id_builder.title") %>
  </h5>

  <div class="mb-3">
    <label class="form-label">
      <%= t("inventories.custom_id_builder.add_element") %>
    </label>

    <% elements = %w[
      fixed_text sequence random_20bit random_32bit
      random_6_digit random_9_digit guid date time
    ] %>

    <div class="d-flex flex-wrap gap-2">
      <% elements.each do |type| %>
        <div class="d-inline-flex align-items-center gap-1">
          <button type="button"
                  class="btn btn-outline-primary btn-sm"
                  data-action="click->custom-id-builder#add"
                  data-type="<%= type %>">
            + <%= t("inventories.custom_id_builder.elements.#{type}.name") %>
          </button>

          <details class="position-relative">
            <summary class="text-primary fw-bold"
                style="cursor:pointer; list-style:none; font-size: 18px;"
                title="<%= t('inventories.custom_id_builder.learn_about') %>">
                &#9432;
            </summary>

            <div class="card shadow p-3 position-absolute"
                 style="z-index: 10; width: 280px; left: 0; top: 25px;">
              <strong>
                <%= t("inventories.custom_id_builder.elements.#{type}.name") %>
              </strong>

              <p class="small mt-2 mb-2">
                <%= t("inventories.custom_id_builder.elements.#{type}.help") %>
              </p>

              <div class="small text-muted">
                <strong>
                  <%= t("inventories.custom_id_builder.example") %>:
                </strong>
                <%= t("inventories.custom_id_builder.elements.#{type}.example") %>
              </div>
            </div>
          </details>
        </div>
      <% end %>
    </div>
  </div>

  <div data-custom-id-builder-target="list"
       data-action="dragover->custom-id-builder#allowDrop drop->custom-id-builder#dropInside"
       class="border rounded p-3 mb-3">

    <% (@inventory.custom_id_format || []).each do |element| %>
      <div data-id-element
           data-element-type="<%= element["type"] %>"
           draggable="true"
           data-action="dragstart->custom-id-builder#dragStart dragend->custom-id-builder#dragEnd"
           class="card p-3 mb-2">

        <div class="d-flex justify-content-between align-items-center mb-2">
          <strong data-element-type>
            <%= t("inventories.custom_id_builder.elements.#{element['type']}.name") %>
          </strong>

          <button type="button"
                  class="btn btn-outline-danger btn-sm"
                  data-action="click->custom-id-builder#remove">
            <%= t("inventories.custom_id_builder.remove") %>
          </button>
        </div>

        <input type="hidden"
               name="inventory[custom_id_format][][type]"
               value="<%= element["type"] %>"
               data-type-input>

        <% if element["type"] == "fixed_text" %>
          <div data-fixed-text-input>
            <label class="form-label">
              <%= t("inventories.custom_id_builder.text") %>
            </label>

            <input type="text"
                   name="inventory[custom_id_format][][value]"
                   value="<%= element["value"] %>"
                   class="form-control"
                   data-value-input
                   data-action="input->custom-id-builder#updatePreview">
          </div>
        <% end %>

        <% if ["sequence", "random_20bit", "random_32bit",
               "random_6_digit", "random_9_digit"].include?(element["type"]) %>

          <div data-number-format-input>
            <label class="form-label">
              <%= t("inventories.custom_id_builder.number_format") %>
            </label>

            <input type="text"
                   name="inventory[custom_id_format][][format]"
                   value="<%= element["format"] || "D4" %>"
                   class="form-control"
                   placeholder="D4, D6, X5"
                   data-format-input
                   data-action="input->custom-id-builder#updatePreview">
          </div>
        <% end %>

      </div>
    <% end %>

  </div>

  <template data-custom-id-builder-target="template">
    <div data-id-element
         draggable="true"
         data-action="dragstart->custom-id-builder#dragStart dragend->custom-id-builder#dragEnd"
         class="card p-3 mb-2">

      <div class="d-flex justify-content-between align-items-center mb-2">
        <strong data-element-type></strong>

        <button type="button"
                class="btn btn-outline-danger btn-sm"
                data-action="click->custom-id-builder#remove">
          <%= t("inventories.custom_id_builder.remove") %>
        </button>
      </div>

      <input type="hidden"
             name="inventory[custom_id_format][][type]"
             data-type-input>

      <div data-fixed-text-input>
        <label class="form-label">
          <%= t("inventories.custom_id_builder.text") %>
        </label>

        <input type="text"
               name="inventory[custom_id_format][][value]"
               class="form-control"
               data-value-input
               data-action="input->custom-id-builder#updatePreview">
      </div>

      <div data-number-format-input>
        <label class="form-label">
          <%= t("inventories.custom_id_builder.number_format") %>
        </label>

        <input type="text"
               name="inventory[custom_id_format][][format]"
               class="form-control"
               placeholder="D4, D6, X5"
               data-format-input
               data-action="input->custom-id-builder#updatePreview">
      </div>

    </div>
  </template>

  <div class="alert alert-info">
    <strong>
      <%= t("inventories.custom_id_builder.preview_title") %>
    </strong>

    <div data-custom-id-builder-target="preview"
         class="fw-bold fs-5 mt-2">
    </div>
  </div>

</div>
