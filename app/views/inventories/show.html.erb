<div class="container mt-4 mb-5">
  <div class="card shadow-sm">
    <div class="card-body p-4">

      <!-- Inventory Title and Category -->
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h2><%= @inventory.title %></h2>

          <p class="text-muted mb-0">
            <%= t("inventories.show.category") %>: <%= @inventory.category %>
          </p>
        </div>

        <%= link_to t("inventories.show.all_inventories"),
            inventories_path,
            class: "btn btn-outline-secondary" %>
      </div>

      <hr>

      <% can_manage = user_signed_in? &&
          (current_user.admin? || @inventory.user_id == current_user.id) %>

      <% can_write = @inventory.can_write_items?(current_user) %>

      <!-- Tab Navigation -->
      <ul class="nav nav-tabs mb-4" id="inventoryTabs" role="tablist">

        <li class="nav-item">
          <button class="nav-link"
                  id="items-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#items"
                  type="button"
                  role="tab">
            <%= t("inventories.show.items") %>
          </button>
        </li>

        <li class="nav-item">
          <button class="nav-link"
                  id="discussion-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#discussion"
                  type="button"
                  role="tab">
            <%= t("inventories.show.discussion") %>
          </button>
        </li>

        <li class="nav-item">
          <button class="nav-link"
                  id="settings-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#settings"
                  type="button"
                  role="tab">
            <%= t("inventories.show.general_settings") %>
          </button>
        </li>

        <li class="nav-item">
          <button class="nav-link"
                  id="custom-id-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#custom-id"
                  type="button"
                  role="tab">
            <%= t("inventories.show.custom_id") %>
          </button>
        </li>

        <% if can_manage %>
          <li class="nav-item">
            <button class="nav-link"
                    id="access-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#access"
                    type="button"
                    role="tab">
              <%= t("inventories.show.access") %>
            </button>
          </li>
        <% end %>

        <li class="nav-item">
          <button class="nav-link"
                  id="custom-fields-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#custom-fields"
                  type="button"
                  role="tab">
            <%= t("inventories.show.custom_fields") %>
          </button>
        </li>

        <li class="nav-item">
          <button class="nav-link"
                  id="statistics-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#statistics"
                  type="button"
                  role="tab">
            <%= t("inventories.show.statistics") %>
          </button>
        </li>

      </ul>

      <!-- Default Description -->
      <div id="inventory-description" class="mb-4">
        <% if @inventory.description.present? %>
          <%= markdown_to_html(@inventory.description) %>
        <% end %>
      </div>

      <!-- Tab Contents -->
      <div class="tab-content">

        <div class="tab-pane fade"
             id="items"
             role="tabpanel"
             aria-labelledby="items-tab">
          <%= render "items_tab" %>
        </div>

        <div class="tab-pane fade"
             id="discussion"
             role="tabpanel"
             aria-labelledby="discussion-tab">
          <%= render "discussion_tab" %>
        </div>

        <div class="tab-pane fade"
             id="settings"
             role="tabpanel"
             aria-labelledby="settings-tab">
          <%= render "settings_tab" %>
        </div>

        <div class="tab-pane fade"
             id="custom-id"
             role="tabpanel"
             aria-labelledby="custom-id-tab">
          <%= render "custom_id_tab" %>
        </div>

        <% if can_manage %>
          <div class="tab-pane fade"
               id="access"
               role="tabpanel"
               aria-labelledby="access-tab">
            <%= render "access_tab" %>
          </div>
        <% end %>

        <div class="tab-pane fade"
             id="custom-fields"
             role="tabpanel"
             aria-labelledby="custom-fields-tab">
          <%= render "custom_fields_tab" %>
        </div>

        <div class="tab-pane fade"
             id="statistics"
             role="tabpanel"
             aria-labelledby="statistics-tab">
          <%= render "statistics_tab" %>
        </div>

      </div>

      <hr class="mt-4">

      <p class="mb-1">
        <strong><%= t("inventories.show.owner") %>:</strong>
        <%= @inventory.user.username %>
      </p>

      <p class="text-muted mb-0">
        <strong><%= t("inventories.show.created") %>:</strong>
        <%= l(@inventory.created_at, format: :long) %>
      </p>

    </div>
  </div>
</div>
