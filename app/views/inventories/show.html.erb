<div class="container mt-4 mb-5">
  <div class="card shadow-sm">
    <div class="card-body p-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h2><%= @inventory.title %></h2>
          <p class="text-muted mb-0">
            <%= t("inventories.show.category") %>: <%= @inventory.category %>
          </p>
        </div>

        <%= link_to t("inventories.show.all_inventories"),
            inventories_path,
            class: "btn btn-outline-secondary" %>
      </div>

      <hr>

      <% can_manage = user_signed_in? &&
          (current_user.admin? || @inventory.user_id == current_user.id) %>

      <% can_write = @inventory.can_write_items?(current_user) %>

      <ul class="nav nav-tabs mb-4" id="inventoryTabs" role="tablist">

        <li class="nav-item">
          <button class="nav-link active"
                  id="items-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#items"
                  type="button">
            <%= t("inventories.show.items") %>
          </button>
        </li>

        <li class="nav-item">
          <button class="nav-link"
                  id="discussion-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#discussion"
                  type="button">
            <%= t("inventories.show.discussion") %>
          </button>
        </li>

        <li class="nav-item">
          <button class="nav-link"
                  id="settings-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#settings"
                  type="button">
            <%= t("inventories.show.general_settings") %>
          </button>
        </li>

        <li class="nav-item">
          <button class="nav-link"
                  id="custom-id-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#custom-id"
                  type="button">
            <%= t("inventories.show.custom_id") %>
          </button>
        </li>

        <% if can_manage %>
          <li class="nav-item">
            <button class="nav-link"
                    id="access-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#access"
                    type="button">
              <%= t("inventories.show.access") %>
            </button>
          </li>
        <% end %>

        <li class="nav-item">
          <button class="nav-link"
                  id="custom-fields-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#custom-fields"
                  type="button">
            <%= t("inventories.show.custom_fields") %>
          </button>
        </li>

        <li class="nav-item">
          <button class="nav-link"
                  id="statistics-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#statistics"
                  type="button">
            <%= t("inventories.show.statistics") %>
          </button>
        </li>

      </ul>

      <div class="tab-content">

        <!-- 1. Items -->
        <div class="tab-pane fade show active"
             id="items"
             role="tabpanel">

          <%= render "items_tab" %>

        </div>

        <!-- 2. Discussion -->
        <div class="tab-pane fade"
             id="discussion"
             role="tabpanel">

          <h4><%= t("inventories.show.discussion") %></h4>
          <p class="text-muted">
            <%= t("inventories.show.discussion_coming_soon") %>
          </p>

        </div>

        <!-- 3. General Settings -->
        <div class="tab-pane fade"
             id="settings"
             role="tabpanel">

          <%= render "settings_tab" %>

        </div>

        <!-- 4. Custom ID -->
        <div class="tab-pane fade"
             id="custom-id"
             role="tabpanel">

          <%= render "custom_id_tab" %>

        </div>

        <!-- 5. Access -->
        <% if can_manage %>
          <div class="tab-pane fade"
               id="access"
               role="tabpanel">

            <%= render "access_tab" %>

          </div>
        <% end %>

        <!-- 6. Custom Fields -->
        <div class="tab-pane fade"
             id="custom-fields"
             role="tabpanel">

          <%= render "custom_fields_tab" %>

        </div>

        <!-- 7. Statistics -->
        <div class="tab-pane fade"
            id="statistics"
            role="tabpanel">

          <%= render "statistics_tab" %>

        </div>

      </div>

      <hr class="mt-4">

      <p class="mb-1">
        <strong><%= t("inventories.show.owner") %>:</strong>
        <%= @inventory.user.username %>
      </p>

      <p class="text-muted mb-0">
        <strong><%= t("inventories.show.created") %>:</strong>
        <%= l(@inventory.created_at, format: :long) %>
      </p>

    </div>
  </div>
</div>

<script>
function activateInventoryTabFromHash() {
  const hash = window.location.hash;

  if (!hash || !window.bootstrap) return;

  const tabButton = document.querySelector(
    `#inventoryTabs [data-bs-target="${hash}"]`
  );

  if (tabButton) {
    bootstrap.Tab.getOrCreateInstance(tabButton).show();
  }
}

document.addEventListener(
  "DOMContentLoaded",
  activateInventoryTabFromHash
);

document.addEventListener(
  "turbo:load",
  activateInventoryTabFromHash
);
</script>