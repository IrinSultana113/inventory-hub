
<div class="table-responsive"
     <% if selectable %>
       data-controller="custom-fields-sort"
       data-custom-fields-sort-url-value="<%= reorder_inventory_custom_fields_path(@inventory) %>"
     <% end %>>

  <table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
      <tr>
        <% if selectable %>
          <th><%= t("inventories.custom_fields_table.order") %></th>
          <th><%= t("inventories.custom_fields_table.select") %></th>
        <% end %>

        <th><%= t("inventories.custom_fields_table.field_title") %></th>
        <th><%= t("inventories.custom_fields_table.field_type") %></th>
        <th><%= t("inventories.custom_fields_table.description") %></th>
        <th><%= t("inventories.custom_fields_table.show_in_table") %></th>
      </tr>
    </thead>

    <tbody>
      <% @inventory.custom_fields.order(:position).each do |field| %>
        <tr
          <% if selectable %>
            draggable="true"
            data-field-id="<%= field.id %>"
            data-action="
              dragstart->custom-fields-sort#dragStart
              dragover->custom-fields-sort#dragOver
              dragend->custom-fields-sort#dragEnd
            "
            style="cursor: grab;"
          <% end %>
        >
          <% if selectable %>
            <td title="<%= t('inventories.custom_fields_table.drag_to_reorder') %>">
              <i class="bi bi-grip-vertical"></i>
            </td>
            <td>
              <%= check_box_tag "custom_field_ids[]", field.id, false %>
            </td>
          <% end %>

          <td><%= field.title %></td>
          <td>
            <%= t("inventories.custom_fields.field_types.#{field.field_type}") %>
          </td>
          <td><%= field.description.presence || "\u2014" %></td>
          <td>
            <%= field.show_in_table? ? t("common.yes") : t("common.no") %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
