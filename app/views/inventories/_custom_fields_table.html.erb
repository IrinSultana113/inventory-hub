
<div class="table-responsive">
  <table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
      <tr>
        <% if selectable %>
          <th><%= t("inventories.custom_fields_table.select") %></th>
        <% end %>
        <th><%= t("inventories.custom_fields_table.field_title") %></th>
        <th><%= t("inventories.custom_fields_table.field_type") %></th>
        <th><%= t("inventories.custom_fields_table.description") %></th>
        <th><%= t("inventories.custom_fields_table.show_in_table") %></th>
      </tr>
    </thead>

    <tbody>
      <% @inventory.custom_fields.order(:position).each do |field| %>
        <tr>
          <% if selectable %>
            <td>
              <%= check_box_tag "custom_field_ids[]", field.id, false %>
            </td>
          <% end %>

          <td><%= field.title %></td>
          <td>
            <%= t("inventories.custom_fields.field_types.#{field.field_type}") %>
          </td>
          <td><%= field.description.presence || "—" %></td>
          <td>
            <%= field.show_in_table? ? t("common.yes") : t("common.no") %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
