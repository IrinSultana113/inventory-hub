<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-7">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <h2 class="mb-4"><%= t("inventories.new.title") %></h2>

          <%= form_with model: @inventory do |form| %>
            <% if @inventory.errors.any? %>
              <div class="alert alert-danger">
                <% @inventory.errors.full_messages.each do |message| %>
                  <p class="mb-1"><%= message %></p>
                <% end %>
              </div>
            <% end %>

            <div class="mb-3">
              <%= form.label :title, t("inventories.new.title_label"),
                  class: "form-label" %>
              <%= form.text_field :title, class: "form-control",
                  placeholder: t("inventories.new.title_placeholder") %>
            </div>

            <div class="mb-3">
              <%= form.label :description, t("inventories.new.description"),
                  class: "form-label" %>
              <%= form.text_area :description, rows: 4, class: "form-control",
                  placeholder: t("inventories.new.description_placeholder") %>
            </div>

            <div class="mb-3">
              <%= form.label :category, t("inventories.new.category"),
                  class: "form-label" %>
              <%= form.text_field :category, class: "form-control",
                  placeholder: t("inventories.new.category_placeholder") %>
            </div>

            <div class="form-check mb-3">
              <%= form.check_box :is_public, class: "form-check-input" %>
              <%= form.label :is_public,
                  t("inventories.new.make_public"),
                  class: "form-check-label" %>
              <div class="form-text">
                <%= t("inventories.new.public_help") %>
              </div>
            </div>

            <div class="mb-4">
              <%= render "custom_id_builder", inventory: @inventory %>
            </div>

            <div class="d-flex gap-2">
              <%= form.submit t("inventories.new.create"),
                  class: "btn btn-primary" %>
              <%= link_to t("inventories.new.cancel"),
                  inventories_path,
                  class: "btn btn-outline-secondary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>