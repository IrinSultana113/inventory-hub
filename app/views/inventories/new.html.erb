<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-7">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <h2 class="mb-4">Create New Inventory</h2>

          <%= form_with model: @inventory do |form| %>
            <% if @inventory.errors.any? %>
              <div class="alert alert-danger">
                <% @inventory.errors.full_messages.each do |message| %>
                  <p class="mb-1"><%= message %></p>
                <% end %>
              </div>
            <% end %>

            <div class="mb-3">
              <%= form.label :title, class: "form-label" %>
              <%= form.text_field :title, class: "form-control", placeholder: "Enter inventory title" %>
            </div>

            <div class="mb-3">
              <%= form.label :description, class: "form-label" %>
              <%= form.text_area :description, rows: 4, class: "form-control", placeholder: "Describe your inventory" %>
            </div>

            <div class="mb-3">
              <%= form.label :category, class: "form-label" %>
              <%= form.text_field :category, class: "form-control", placeholder: "e.g. Electronics, Books" %>
            </div>

            <div class="form-check mb-3">
              <%= form.check_box :is_public, class: "form-check-input" %>
              <%= form.label :is_public, "Make this inventory public",
                class: "form-check-label" %>
              <div class="form-text">
                Public inventories allow all logged-in users to create, edit, and delete items.
              </div>
            </div>

            <div class="d-flex gap-2">
              <%= form.submit "Create Inventory", class: "btn btn-primary" %>
              <%= link_to "Cancel", inventories_path, class: "btn btn-outline-secondary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>