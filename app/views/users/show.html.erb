<div class="container mt-4">

  <div class="card shadow-sm">
    <div class="card-body">
      <h3><%= @user.username %></h3>
      <p class="text-muted">User Profile</p>
    </div>
  </div>

  <h4 class="mt-4">Public Inventories</h4>

  <% if @inventories.any? %>

    <div class="table-responsive">
      <table class="table table-striped">
        <thead>
          <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Created At</th>
          </tr>
        </thead>

        <tbody>
          <% @inventories.each do |inventory| %>
            <tr>
              <td>
                <%= link_to inventory.title, inventory_path(inventory) %>
              </td>

              <td><%= inventory.category %></td>

              <td><%= l(inventory.created_at, format: :long) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  <% else %>

    <p class="text-muted">No public inventories yet.</p>

  <% end %>

</div>